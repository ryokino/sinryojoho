# local = ログインなし（既定） / toolbox = ツールボックス SSO 必須
PERMISSIONS_SOURCE=

# Auth.js セッション署名（toolbox のとき必須。値は本番・Preview で別途設定）
AUTH_SECRET=

# ツールボックス本体の URL（例: https://toolbox.nzm-mc.com）
TOOLBOX_BASE_URL=

# ツールボックス permissions API 用トークン（値はリポに書かない）
TOOLBOX_PERMISSIONS_TOKEN=

# Preview デプロイだけ preview にすると Preview 用戻り先を使う
TOOLBOX_SSO_RETURN=
